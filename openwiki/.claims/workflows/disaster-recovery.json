  "claims": [
    {
      "id": "claim_02b43a253d2541649d236907e4c761f4",
      "statement": "The disaster-recovery entrypoint is an interactive destructive cluster rebuild, not backup restoration: it warns that workloads and data will be lost, requires exact yes confirmation, runs sequential phases without rollback or resume, and a rerun begins at deletion again.",
      "evidence": [
        {
          "resource": "repo://scripts/disaster-recovery.sh",
          "version": "repo-file-v1:sha256:bc5c32662df4cc3fca60a0c8990e3b0da1e9692e62524525f777449a9935a0e6"
        }
      ]
    },
    {
      "id": "claim_06c8e20cbc1249b3b86ff99af021604e",
      "statement": "The mise disaster-recovery task directly executes ./scripts/disaster-recovery.sh; the script requires Bash associative arrays and strict shell execution rather than POSIX sh or Bash 3.2.",
      "evidence": [
        {
          "resource": "repo://mise.toml#L92-L95",
          "version": "repo-lines-v1:sha256:2af43ec9630c1a7e22c3b3d7fd121ffd15cd19266ca64c97ebddee1678d74944:"
